# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase anon (public) key — used by the frontend, safe to expose client-side
SUPABASE_ANON_KEY=

# Supabase service-role key — server/worker only, bypasses RLS. Never send to the client.
# Used by packages/storage/storage/supabase_storage.py for the private invoice bucket.
SUPABASE_SERVICE_KEY=

# Supabase Storage bucket for uploaded invoice files. Defaults to "invoices" if unset.
SUPABASE_STORAGE_BUCKET=

# Postgres connection string used by the API and, for per-job handler
# queries, the worker -- connects as the ordinary app_role, fully subject
# to RLS. Direct or via Supabase pooler.
DATABASE_URL=

# Postgres connection string the worker uses for queue management only
# (enqueue/claim_next/complete/fail/reap_stale_locks) -- connects as
# queue_claimer (db/migrations/0012_queue_claimer_role.sql), which can see
# jobs across every tenant but has no grant on any other table. Never used
# for handler queries. See db/README.md's "Security model" section.
QUEUE_CLAIMER_DATABASE_URL=

# Gemini API key for invoice extraction (Gemini Flash, free tier)
GEMINI_API_KEY=

# Gemini model name. Defaults to gemini-3.6-flash if unset -- see the Gemini
# model note in CLAUDE.md. Overriding this is how a future free-tier model
# rotation gets handled without a code change.
GEMINI_MODEL=

# Gemini free-tier rate limit, requests/minute. Defaults to 10 if unset.
GEMINI_RATE_LIMIT_RPM=

# Which extraction backend packages/extractors/factory.py picks as the
# primary: "gemini", "tesseract", or "mock". Defaults to "gemini" if unset.
EXTRACTOR_BACKEND=

# Telegram bot token for the approval notifier
TELEGRAM_BOT_TOKEN=

# Telegram chat ID that receives approval requests
TELEGRAM_CHAT_ID=

# SMTP host for the secondary email notifier, e.g. smtp.gmail.com
SMTP_HOST=

# SMTP auth username
SMTP_USER=

# SMTP auth password (use an app password, not your account password)
SMTP_PASS=

# HMAC-SHA256 signing secret for verifying inbound webhook authenticity
WEBHOOK_SIGNING_SECRET=

# Public base URL of the deployed app, used to build approval links, e.g. https://app.example.com
APP_BASE_URL=
