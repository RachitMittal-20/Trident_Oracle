# Base URL of the running FastAPI app (apps/api). Defaults to
# http://localhost:8000 if unset, which matches this repo's own
# `uvicorn api.main:app` default port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Placeholder for real authentication, which doesn't exist yet in this
# project -- every page that would normally read the signed-in session's
# tenant reads this env var directly instead. Must be a real tenants.id row
# (e.g. from db/seed/seed.py's seeded tenant) for any page to show data.
NEXT_PUBLIC_DEMO_TENANT_ID=

# Same placeholder pattern, for "the signed-in user". Must be a real
# users.id row with role 'admin' or 'approver' (apps/api/api/match_view.py)
# for the Approve/Reject actions on /invoices/[id]/match to be permitted.
NEXT_PUBLIC_DEMO_USER_ID=
